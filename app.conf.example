[app]
# Loglevel can be one of: debug, info, warning, error, critical
loglevel=debug
# Possible scopes for which a PRS-client can be authorized
scopes = read write delete admin

[logging]
# All keys are optional.
# Log server in host:port format (UDP). Leave empty to log to stdout only.
syslog_path=
# Streams sent to the log server, comma separated, from app, siem,
# public_inspect and debug. Each JSON record carries its stream_id.
syslog_streams=app,siem,public_inspect
# Stamped on every JSON record as application_id, so the log server can tell
# applications sharing the channel apart.
application_id=prs-beheer-api
# Streams printed to stdout as readable text, comma separated, from app, siem
# and debug. The debug stream already holds every record.
console_streams=debug
# Include tracebacks on the console and on the debug stream.
include_traces=True
# Emit an access record per request.
access_logs=True
# Log an error when a request arrives without an X-GF-Correlation-ID header.
correlation_id_expected=False
# Read the client ip from X-Forwarded-For instead of the connection. The header
# is set by the caller, so only enable this where a proxy in front of this
# application rewrites it.
trust_forwarded_for=False

[database]
# Dsn for database connection
dsn=postgresql+psycopg://postgres:postgres@postgres:5432/postgres
# Retry backoff (in seconds) for database connection
retry_backoff=0.1, 0.2, 0.4, 0.8, 1.6, 3.2, 4.8, 6.4, 10.0
# Connection pool size, use 0 for unlimited connections
pool_size=5
# Max overflow for connection pool
max_overflow=10
# Pre ping the connection before using it
pool_pre_ping=False
# Recycle the connection after this time (in seconds)
pool_recycle=1800

[telemetry]
# Telemetry is enabled or not
enabled = False
# Endpoint to GRPC server for telemetry
endpoint = http://tracing:4317
# Service name to use
service_name = PRS Beheer API
# Tracer name to use
tracer_name = zmodules.service.prs_beheer_api

[stats]
# Statsd is enabled or not
enabled = False
# Host for statsd server
host = 127.0.0.1
# Port for statsd server
port = 8125
# Module name for statsd
module_name = prs-beheer-api


[uvicorn]
# If true, the api docs will be enabled
swagger_enabled = True
# Endpoint for swagger api docs
docs_url = /docs
# Endpoint for redoc api docs
redoc_url = /redocs
# If set to true, swagger will show fields to provide x-gf headers
# Should be disabled on production, this is not an security risk because
# x-gf headers are stripped by the gateway
document_gf_headers = True
# Host for the uvicorn server
host = 0.0.0.0
# Port for the uvicorn server
port = 8512
# Live reload for uvicorn server
reload = True
# The root path if behind a proxy
root_path =

# SSL configuration
use_ssl = False
ssl_base_dir = secrets/ssl
ssl_cert_file = server.cert
ssl_key_file = server.key
